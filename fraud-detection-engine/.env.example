# Copy to .env and fill in. .env is never committed.
# Every variable the application reads is listed here; the app fails to start if a
# required one is missing or invalid, rather than falling back to a default.

# REQUIRED. One of: development | staging | production.
# Controls whether /docs and /redoc are served. No default, deliberately: the
# previous code treated an unset value as production silently.
ENV=

# REQUIRED. Comma-separated list of origins allowed to call the API from a browser.
# Must not be '*'. Each environment states its own.
# Example: CORS_ORIGINS=["https://app.example.com","https://staging.example.com"]
CORS_ORIGINS=

# Optional. One of: DEBUG | INFO | WARNING | ERROR | CRITICAL. Defaults to INFO.
LOG_LEVEL=

# Optional. Absolute or relative path to the model artifact.
# Defaults to <project root>/models/fraud_model.pkl.
MODEL_PATH=

# Optional. slowapi rate limit expression for /predict. Defaults to 30/minute.
PREDICT_RATE_LIMIT=
